# CouchGraph environment variables
# Copy this file to .env and fill in your values.
# All variables can also be set directly in the environment.

# ── CouchDB ───────────────────────────────────────────────────────────────
COUCHGRAPH_COUCHDB_URL=http://localhost:5984
COUCHGRAPH_COUCHDB_USER=admin
COUCHGRAPH_COUCHDB_PASSWORD=password
COUCHGRAPH_COUCHDB_DATABASE=couchgraph

# ── Server ────────────────────────────────────────────────────────────────
COUCHGRAPH_SERVER_PORT=8080
# Set to "false" to disable the Playground in production
COUCHGRAPH_SERVER_PLAYGROUND_ENABLED=true

# ── Logging ───────────────────────────────────────────────────────────────
# Levels: debug | info | warn | error
COUCHGRAPH_LOG_LEVEL=info
# Formats: json | console
COUCHGRAPH_LOG_FORMAT=console
