# ─────────────────────────────────────────────────────────────────────────────
# CouchGraph Environment Configuration
# Copy this file to .env and customize your values.
# Both COUCHDB_* and COUCHGRAPH_COUCHDB_* formats are supported.
# ─────────────────────────────────────────────────────────────────────────────

# ── CouchDB Connection ───────────────────────────────────────────────────────
# URL of your CouchDB instance (use http://couchdb:5984 inside Docker)
COUCHDB_URL=http://localhost:5984

# CouchDB Administrator Credentials
COUCHDB_USER=admin
COUCHDB_PASSWORD=password

# Database to create and use by default
COUCHDB_DATABASE=couchgraph

# ── Server Configuration ────────────────────────────────────────────────────
# Port to listen on (default: 8080)
PORT=8080

# Enable GraphQL Playground at root URL (true for dev, false for public production)
PLAYGROUND_ENABLED=true

# ── Logging ─────────────────────────────────────────────────────────────────
# Log Level: debug | info | warn | error
LOG_LEVEL=info

# Log Format: console | json
LOG_FORMAT=console
