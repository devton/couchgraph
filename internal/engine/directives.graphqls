"""
Maps an object type to the CouchDB documents whose discriminator field equals `type`.
Used by @get (type check), @find (discriminator added to the selector automatically) and
the write directives (discriminator set on every write).
`keys` is how input fields are named in stored documents: "snake_case" (runtimeMinutes →
runtime_minutes, the default) or "as_is".
"""
directive @collection(type: String!, field: String = "type", keys: String = "snake_case") on OBJECT

"""
Reads the field from another document key. Dot paths are allowed (e.g. "value.min").
Without it, fields are read by name, then `_id` for `id`, then the snake_case form.
On input fields (and on object fields matched by name), it is also the key written by
@create/@update. Dot paths are read-only.
"""
directive @field(from: String!) on FIELD_DEFINITION | INPUT_FIELD_DEFINITION

"""
Fetches one document by ID (the `id` argument by default), batched via _bulk_get.
"""
directive @get(arg: String = "id") on FIELD_DEFINITION

"""
Runs a Mango _find query. `selector` and `sort` are JSON. String values "$arg" are
replaced by field arguments; entries whose argument is absent are dropped.
Field arguments named limit, skip and bookmark are applied automatically.
"""
directive @find(selector: String = "{}", sort: String, limit: Int) on FIELD_DEFINITION

"""
Queries a MapReduce view ("designDoc/viewName"). `key` is JSON or a "$arg" placeholder.
Rows become: reduce rows {key, value}; otherwise the included doc, the emitted object
value, or {id, key, value}. Field arguments named limit, skip and descending are applied.
"""
directive @view(
  name: String!
  key: String
  reduce: Boolean = false
  group: Boolean
  groupLevel: Int
  includeDocs: Boolean = false
  descending: Boolean
) on FIELD_DEFINITION

"""
1:1 relation: loads the document whose _id is stored in the parent's `field` (batched).
A list of IDs is supported for list fields.
"""
directive @belongsTo(field: String!) on FIELD_DEFINITION

"""
1:N relation: queries `view` ("designDoc/viewName") with `key` (default: the parent _id).
"""
directive @hasMany(view: String!, key: String = "$parent.id") on FIELD_DEFINITION

"""
Creates a document of the returned @collection type from the `input` argument (an input
object). The ID is a generated UUIDv7 and the discriminator is set automatically. Only
allowed on Mutation fields. Returns the stored document.
"""
directive @create(input: String = "input") on FIELD_DEFINITION

"""
Merges the `input` argument into the document identified by `arg`. Absent input fields are
kept, explicit nulls remove the key. If the field declares a `rev` argument, it pins the
expected revision (optimistic locking); otherwise lost races are retried. Returns the
updated document.
"""
directive @update(arg: String = "id", input: String = "input") on FIELD_DEFINITION

"""
Deletes the document identified by `arg` (type-checked against the returned @collection).
An optional `rev` argument pins the expected revision. Returns the document as it was
before deletion.
"""
directive @delete(arg: String = "id") on FIELD_DEFINITION
