# Environment variables for Dokploy Compose deployment
# Set these in your Dokploy Dashboard -> Compose Stack -> Environment tab

# Domain where CouchGraph will be publicly accessible (e.g., couchgraph.yourdomain.com)
DOMAIN=couchgraph.yourdomain.com

# CouchDB Administrator Credentials (choose a strong password)
COUCHDB_USER=admin
COUCHDB_PASSWORD=super_secret_couchdb_password_123

# CouchDB default database name (will be created automatically if it doesn't exist)
COUCHDB_DATABASE=couchgraph

# Enable GraphQL Playground at root URL (true/false - recommended false in public production)
PLAYGROUND_ENABLED=false

# Logging level: debug | info | warn | error
LOG_LEVEL=info
